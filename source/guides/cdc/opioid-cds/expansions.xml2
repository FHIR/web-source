          <valueString value="Medication"/>
        </extension>
        <extension url="http://fhir.org/guides/cdc/opioid-cds/StructureDefinition/cdc-valueset-inclusion-criteria">
          <valueString value="All opioid clinical drugs except those used in antitussives or antispasmodics, or are restricted to surgical use only."/>
        </extension>
        <extension url="http://fhir.org/guides/cdc/opioid-cds/StructureDefinition/cdc-valueset-exclusion-criteria">
          <valueString value="For any drug other than methadone, any mediation that is not using a long acting formulation."/>
