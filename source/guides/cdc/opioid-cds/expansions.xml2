        <extension url="http://fhir.org/guides/cdc/opioid-cds/StructureDefinition/cdc-valueset-clinical-focus">
          <valueString value="The purpose of this value set is to represent concepts for barbiturate medications"/>
        </extension>
        <extension url="http://fhir.org/guides/cdc/opioid-cds/StructureDefinition/cdc-valueset-dataelement-scope">
          <valueString value="Medication"/>
        </extension>
        <extension url="http://fhir.org/guides/cdc/opioid-cds/StructureDefinition/cdc-valueset-inclusion-criteria">
          <valueString value="Includes amobarbital, butabarbital, butalbital, pentobarbital, phenobarbital and secobarbital. Includes concepts that represent generic, human use and prescribable medications"/>
        </extension>
        <extension url="http://fhir.org/guides/cdc/opioid-cds/StructureDefinition/cdc-valueset-exclusion-criteria">
          <valueString value="Excludes concepts that represent non-prescribable or branded drugs and excludes concepts that represent components or ingredients"/>
        </extension>
