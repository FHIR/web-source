  ], [
     fhir:index 6 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSCommonConfig" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Age Less than 18 Years Is Enabled" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "// CDC 2022 General Inclusion Criteria\ndefine \"Age Less than 18 Years Is Enabled\":\n  true" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "2"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 7 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSRoutines" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Patient Age Less Than 18" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "define \"Patient Age Less Than 18\":\n  if (Config.\"Age Less than 18 Years Is Enabled\") then\n    AgeInYearsAt(Today()) < 18\n  else false" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "3"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 8 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSCommonConfig" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Sickle Cell Check Enabled" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "// Sickle Cell\ndefine \"Sickle Cell Check Enabled\":\n  true" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "4"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 9 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSCommonConfig" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Sickle Cell Assumed Active" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "define \"Sickle Cell Assumed Active\":\n  true" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "5"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 10 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSCommon" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "US Core-Categorized Conditions" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "// 3. Medications indicating end of life\n    /* or exists (\n      \"Medications Indicating End of Life\"\n    ) */\n\ndefine \"US Core-Categorized Conditions\":\n  [Condition: category in \"Encounter Diagnosis Condition Category\"]\n    union [Condition: category in \"Problem List Condition Category\"]\n    union [Condition: category in \"US Core Health Concern Condition Category\"]" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "6"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 11 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSCommon" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Positive Sickle Cell Condition" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "define \"Positive Sickle Cell Condition\":\n  if Config.\"Sickle Cell Check Enabled\" and not Config.\"Sickle Cell Assumed Active\"\n    then (\n      \"US Core-Categorized Conditions\" C\n        where C.code in \"Sickle Cell Diseases\"\n          and C.clinicalStatus in \"Active Condition\"\n    ) else if Config.\"Sickle Cell Check Enabled\" and Config.\"Sickle Cell Assumed Active\"\n        then (\n          \"US Core-Categorized Conditions\" C\n            where C.code in \"Sickle Cell Diseases\"\n        )\n      else null" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "7"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 12 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSRoutines" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Condition Positive for Sickle Cell" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "define \"Condition Positive for Sickle Cell\":\n  if (Config.\"Sickle Cell Check Enabled\") then\n    exists(\n      Common.\"Positive Sickle Cell Condition\"\n    ) \n  else false" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "8"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 13 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSCommonConfig" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Active Cancer Treatment Encounters Condition Is Enabled" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "// Active Cancer Treatment\ndefine \"Active Cancer Treatment Encounters Condition Is Enabled\":\n  true" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "9"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 14 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSRoutines" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Encounter Period" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "// End of Opioid Naive Routine\n\n/*\n**  Routine #3\n**  Active Cancer Treatment Routine\n**\n**  Definition                    | Answer to Proceed   | Details                                    | Data (Terminology) Requirement\n**  ---------------------------------------------------------------------------------------------------------------------------------\n**  Two office visits within the  | No                  | Look for a minimum of two distinct         | Office Visit\n**  past 12 months                |                     | encounters within 12 months of the date    |\n**                                |                     | of the current visit for which each of the |\n**                                |                     | following is true:                         |\n**                                |                     |   - the encounter diagnosis (primary or    |\n**                                |                     |     secondary or co-morbidity diagnosis)   |\n**                                |                     |     is listed in the CDC Malignant Cancer  |\n**                                |                     |     Conditions value set                   |\n**  ---------------------------------------------------------------------------------------------------------------------------------\n**  Office visits with an         | No                  | The encounter is performed by an           | Oncology specialty\n**  oncology specialist           |                     | oncologist as defined in the oncology      | designations (NUCC)\n**  present                       |                     | specialty designations using the           |\n**                                |                     | National Uniform Claim Committee           |\n**                                |                     | (NUCC) classifications                     |\n**  ---------------------------------------------------------------------------------------------------------------------------------\n**  Office visits including CDC   | No                  | The encounter diagnosis (primary or        | CDC malignant cancer\n**  malignant cancer              |                     | secondary or co-morbidity diagnosis)       | conditions\n**  condition                     |                     | is listed in the CDC Malignant Cancer      |\n**                                |                     | Conditions value set                       |\n**  ----------------------------------------------------------------------------------------------------------------------------------\n**\n*/\n\ndefine \"Encounter Period\":\n  Interval[Today() - 12 months, Today())" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "10"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 15 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSCommon" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "USCore Encounter Cancer Diagnoses" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "define \"USCore Encounter Cancer Diagnoses\":\n  [Condition: category in \"Encounter Diagnosis Condition Category\"] CancerDiagnoses\n    where CancerDiagnoses.code in \"CDC malignant cancer conditions\"" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "11"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 16 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSRoutines" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Encounters with Cancer Diagnosis During Encounter Period" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "// encounter-diagnosis, problem-list and health-concern Conditions\n// define \"US Core-Categorized Cancer Diagnoses\":\n//   Common.\"US Core-Categorized Conditions\" C\n//     where C.code in Common.\"CDC malignant cancer conditions\"\n\n// define \"Encounters with Cancer Diagnosis During Encounter Period\":\n//   [Encounter] Encounter\n//     with \"US Core-Categorized Cancer Diagnoses\" CancerDiagnosis\n//     such that date from Encounter.period.\"start\".value in day of \"Encounter Period\"\n//       and EndsWith(CancerDiagnosis.encounter.reference, Encounter.id)\n\ndefine \"Encounters with Cancer Diagnosis During Encounter Period\":\n  [Encounter] Encounters\n    where date from Encounters.period.\"start\" in day of \"Encounter Period\"\n      and exists (\n        Common.\"USCore Encounter Cancer Diagnoses\" CancerDiagnoses\n          where EndsWith(CancerDiagnoses.encounter.reference, Encounters.id)\n      )" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "12"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 17 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSRoutines" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Number of Encounters with Cancer Diagnosis During Encounter Period" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "define \"Number of Encounters with Cancer Diagnosis During Encounter Period\":\n  Count (\"Encounters with Cancer Diagnosis During Encounter Period\")" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "13"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 18 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSRoutines" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Has Two or More Encounters with Cancer Diagnosis During Encounter Period" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "define \"Has Two or More Encounters with Cancer Diagnosis During Encounter Period\":\n  \"Number of Encounters with Cancer Diagnosis During Encounter Period\" >= 2" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "14"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 19 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSCommon" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "USCore Problem List Cancer Diagnoses" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "define \"USCore Problem List Cancer Diagnoses\":\n  [Condition: category in \"Problem List Condition Category\"] CancerDiagnoses\n    where CancerDiagnoses.code in \"CDC malignant cancer conditions\"" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "15"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 20 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSRoutines" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Has Active Cancer Diagnosis on Problem List" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "define \"Has Active Cancer Diagnosis on Problem List\":\n  exists (\n    Common.\"USCore Problem List Cancer Diagnoses\" CancerDiagnoses\n      where CancerDiagnoses.category in Common.\"Problem List Condition Category\"\n        and exists(\n          CancerDiagnoses.clinicalStatus.coding ClinicalStatus\n            where ClinicalStatus.code ~ 'active'\n        )\n  )" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "16"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 21 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSRoutines" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Is Active Cancer Treatment?" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "define \"Is Active Cancer Treatment?\":\n  if (Config.\"Active Cancer Treatment Encounters Condition Is Enabled\") \n    then \"Has Two or More Encounters with Cancer Diagnosis During Encounter Period\"\n      or \"Has Active Cancer Diagnosis on Problem List\"\n  else false" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "17"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 22 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSCommonConfig" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "End-Stage Disease Criteria Enabled" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "// CDC 2022 General Inclusion Criteria\ndefine \"End-Stage Disease Criteria Enabled\":\n  true" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "18"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 23 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSRoutines" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Conditions Likely Terminal for Opioid Prescribing" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "define \"Conditions Likely Terminal for Opioid Prescribing\":\n  if (Config.\"End-Stage Disease Criteria Enabled\") then\n    exists (\n      Common.\"US Core-Categorized Conditions\" EOLC\n        where EOLC.code in Common.\"Conditions likely terminal for opioid prescribing\"\n          // and EOLC.clinicalStatus in Common.\"Active Condition\"\n    )\n  else false" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "19"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 24 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSRoutines" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "CDC 2022 Guideline General Inclusion Criteria" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "define \"CDC 2022 Guideline General Inclusion Criteria\":\n  not \"Patient Age Less Than 18\"\n    and not \"Condition Positive for Sickle Cell\"\n    and not \"Is Active Cancer Treatment?\"\n    and not \"Conditions Likely Terminal for Opioid Prescribing\"" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "20"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 25 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSREC08" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Inclusion Criteria" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "define \"Inclusion Criteria\":\n  \"Patient Is Being Prescribed Opioid Analgesic with Ambulatory Misuse Potential\"\n    and Routines.\"CDC 2022 Guideline General Inclusion Criteria\"" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "21"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 26 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSREC08" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Is Recommendation Applicable?" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "define \"Is Recommendation Applicable?\":\n  \"Inclusion Criteria\"" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "22"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 27 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSCommon" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Is Opioid Analgesic with Ambulatory Misuse Potential?" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "define function \"Is Opioid Analgesic with Ambulatory Misuse Potential?\"(value List<MedicationRequest>):\n  (\"Get MedicationRequest Medication as Code\"(value)) Rx\n    where Rx.medication in \"Opioid analgesics with ambulatory misuse potential\" \n      and Rx.category in \"Community\"" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "23"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 28 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSCommon" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Get MedicationRequest Medication as Code" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "define function \"Get MedicationRequest Medication as Code\"(value List<MedicationRequest>):\n  value Rx\n    let Med: \n      if Rx.medication is Reference then singleton from (\n        [Medication] M\n          where M.id = (Last(Split((Rx.medication as FHIR.Reference).reference, '/')))\n      ) else null\n    return \n      MedicationRequest {\n        id: Rx.id,\n        status: Rx.status,\n        intent: Rx.intent,\n        category: Rx.category,\n        medication: if Rx.medication is Reference then Med.code else Rx.medication as CodeableConcept,\n        subject: Rx.subject,\n        authoredOn: Rx.authoredOn,\n        recorder: Rx.recorder,\n        dosageInstruction: Rx.dosageInstruction,\n        dispenseRequest: Rx.dispenseRequest\n      }" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "24"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 29 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "FHIRHelpers" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "ToString" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "define function ToString(value string): value.value" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "25"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 30 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "FHIRHelpers" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "ToConcept" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "define function ToConcept(concept FHIR.CodeableConcept):\n    if concept is null then\n        null\n    else\n        System.Concept {\n            codes: concept.coding C return ToCode(C),\n            display: concept.text.value\n        }" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "26"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 31 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "FHIRHelpers" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "ToCode" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "define function ToCode(coding FHIR.Coding):\n    if coding is null then\n        null\n    else\n        System.Code {\n          code: coding.code.value,\n          system: coding.system.value,\n          version: coding.version.value,\n          display: coding.display.value\n        }" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "27"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 32 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSRoutines" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Is Subacute or Chronic Pain Prescription?" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "// End of Active Cancer Treatment Routine\n\n/*\n**  Routine #4\n**  For Subacute or Chronic Pain Routine\n**\n**  Definition                  | Answer to Proceed   | Details                                        | Data (Terminology) Requirement\n**  -----------------------------------------------------------------------------------------------------------------------------------\n**  Order for opioid analgesic  | Yes                 | Order for opioid analgesics with ambulatory    | Opioid analgesics with\n**  with expected supply        |                     | misuse potential with a supply duration of >=  | ambulatory misuse potential\n**  duration >= 28 days         |                     | 28 days                                        |\n**                              |                     |                                                |\n**                              |                     | - Subacute definition = order for opioid       |\n**                              |                     |   analgesics with ambulatory misuse            |\n**                              |                     |   potential with a supply duration of one to   |\n**                              |                     |   two months.                                  |\n**                              |                     | - Chronic pain definition = order for opioid   |\n**                              |                     |   analgesics with ambulatory misuse            |\n**                              |                     |   potential with a supply duration of >= two   |\n**                              |                     |   months.                                      |\n**  -----------------------------------------------------------------------------------------------------------------------------------\n**\n*/\n\ndefine function \"Is Subacute or Chronic Pain Prescription?\"(prescription FHIR.MedicationRequest):\n  \"Is Subacute or Chronic Pain Using Expected Supply Duration\"(prescription)\n    or \"Is Subacute or Chronic Pain Using Validity Period\"(prescription)" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "28"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 33 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSRoutines" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Is Subacute or Chronic Pain Using Expected Supply Duration" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "define function \"Is Subacute or Chronic Pain Using Expected Supply Duration\"(prescription FHIR.MedicationRequest):\n  (\n    prescription.dispenseRequest is not null\n      and prescription.dispenseRequest.expectedSupplyDuration is not null\n      and (\n        Common.GetDurationInDays(prescription.dispenseRequest.expectedSupplyDuration) >= 28 days \n      )\n  )" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "29"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 34 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSCommon" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "GetDurationInDays" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "define function GetDurationInDays(value FHIR.Duration):\n  if value is null then null\n  else\n    case\n      when value.code.value ~ 'a' then System.Quantity{ value: value.value.value * 365.0, unit: 'days' }\n      when value.code.value ~ 'mo' then System.Quantity{ value: value.value.value * 30.0, unit: 'days' }\n      when value.code.value ~ 'wk' then System.Quantity{ value: value.value.value * 7.0, unit: 'days' }\n      when value.code.value ~ 'd' then System.Quantity{ value: value.value.value, unit: 'days' }\n      when value.code.value ~ 'h' then System.Quantity{ value: value.value.value / 24.0, unit: 'days' }\n      when value.code.value ~ 'min' then System.Quantity{ value: value.value.value / 60.0 / 24.0, unit: 'days' }\n      when value.code.value ~ 's' then System.Quantity{ value: value.value.value / 60.0 / 60.0 / 24.0, unit: 'days' }\n      when value.code.value ~ 'ms' then System.Quantity{ value: value.value.value / 60.0 / 60.0 / 24.0 / 1000.0, unit: 'days' }\n      when value.code.value is null then Message(1000, true, 'Undefined', 'Error', 'Duration unit code is null')\n      else Message(1000, true, 'Undefined', 'Error', 'Unsupported duration unit code: ' + value.code.value)\nend" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "30"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 35 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSRoutines" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Is Subacute or Chronic Pain Using Validity Period" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "define function \"Is Subacute or Chronic Pain Using Validity Period\"(prescription FHIR.MedicationRequest):\n  (\n    prescription.dispenseRequest is not null\n      and prescription.dispenseRequest.validityPeriod is not null\n      and (\n        days between prescription.dispenseRequest.validityPeriod.start and prescription.dispenseRequest.validityPeriod.end >= 28 \n      )\n  )" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "31"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
