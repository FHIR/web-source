  ], [
     fhir:index 4 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSREC08" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Chronic Pain Opioid Analgesic with Ambulatory Misuse Potential Prescriptions" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "define \"Chronic Pain Opioid Analgesic with Ambulatory Misuse Potential Prescriptions\":\n  ( Common.\"Is Opioid Analgesic with Ambulatory Misuse Potential?\"( ContextPrescriptions ) ) AmbulatoryOpioidPrescription\n    where Routines.\"Is Subacute or Chronic Pain Prescription?\"( AmbulatoryOpioidPrescription )" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
       fhir:Extension.valueInteger [ fhir:value "0"^^xsd:integer ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-logicDefinition" ]
  ], [
     fhir:index 5 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "libraryName" ] ;
       fhir:Extension.valueString [ fhir:value "OpioidCDSREC08" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "name" ] ;
       fhir:Extension.valueString [ fhir:value "Patient Is Being Prescribed Opioid Analgesic with Ambulatory Misuse Potential" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "define \"Patient Is Being Prescribed Opioid Analgesic with Ambulatory Misuse Potential\":\n  exists( \"Chronic Pain Opioid Analgesic with Ambulatory Misuse Potential Prescriptions\" )" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
