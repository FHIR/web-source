       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "text" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "Maintenance search expression: `multiaxial_descendantsof:(LP16058-7 OR LP392128-7) AND system:urine`. The compose anchors at two trunk LP codes - LP16058-7 and LP392128-7 - using `concept is-a` filters scoped to SYSTEM=LP7681-2 (urine) and CLASSTYPE=1 (lab test). To regenerate: re-run the search expression as a LOINC hierarchy query, add any newly-discovered trunk LP code as another is-a filter, then re-expand." ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-artifactComment" ]
  ] ;
