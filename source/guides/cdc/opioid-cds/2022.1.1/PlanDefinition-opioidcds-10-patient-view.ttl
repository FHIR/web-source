       fhir:Extension.valueString [ fhir:value "define function GetPositiveLabsInLookbackPeriod(Labs List<FHIR.Observation>, Enabled Boolean):\n  if Enabled\n    then Labs Lab\n     where StartsWith(Lower(Lab.value as FHIR.string), 'pos')\n  else {}" ]
     ], [
