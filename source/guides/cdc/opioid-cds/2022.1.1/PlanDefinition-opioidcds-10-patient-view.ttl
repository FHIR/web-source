       fhir:Extension.valueString [ fhir:value "// Barbiturates\ndefine \"Barbiturate Screenings In Lookback Period\":\n  \"All Opioid or Non-opioid UDS in Lookback Period\" Lab\n    where Lab.code in Common.\"Barbiturate Urine Tests\"" ]
     ], [
       fhir:index 3 ;
