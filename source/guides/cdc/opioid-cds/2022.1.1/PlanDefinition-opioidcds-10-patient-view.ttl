       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "define \"Positive Amphetamine Screenings In Lookback Period\":\n  GetPositiveLabsInLookbackPeriod(\"Amphetamine Screenings In Lookback Period\", true)" ]
     ], [
       fhir:index 3 ;
       fhir:Extension.url [ fhir:value "displaySequence" ] ;
