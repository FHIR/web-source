       fhir:Extension.valueString [ fhir:value "Get HTML Details" ]
     ], [
       fhir:index 2 ;
       fhir:Extension.url [ fhir:value "statement" ] ;
       fhir:Extension.valueString [ fhir:value "// HTML Generation\n\ndefine \"Get HTML Details\":\n  Common.\"Style Header\" & \"Unexpected Div Start\" & \"Details Table\" & \"Expected Result Footnote\" & \"Details More Info\" & \"Div End\"" ]
     ], [
       fhir:index 3 ;
