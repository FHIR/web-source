  fhir:DomainResource.extension [
     fhir:index 0 ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/valueset-author" ] ;
     fhir:Extension.valueContactDetail [
       fhir:ContactDetail.name [ fhir:value "MD Partners, Inc." ] ;
       fhir:ContactDetail.telecom [
         fhir:index 0 ;
         fhir:ContactPoint.system [ fhir:value "email" ] ;
         fhir:ContactPoint.value [ fhir:value "info@mdpartners.com" ]
       ]
     ]
  ], [
     fhir:index 1 ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-knowledgeCapability" ] ;
     fhir:Extension.valueCode [ fhir:value "computable" ]
  ], [
     fhir:index 2 ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-knowledgeCapability" ] ;
     fhir:Extension.valueCode [ fhir:value "executable" ]
  ], [
     fhir:index 3 ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-usageWarning" ] ;
     fhir:Extension.valueString [ fhir:value "This value set contains a point-in-time expansion enumerating the codes that meet the value set intent. As new versions of the code systems used by the value set are released, the contents of this expansion will need to be updated to incorporate newly defined codes that meet the value set intent. Before, and periodically during production use, the value set expansion contents SHOULD be updated. The value set expansion specifies the timestamp when the expansion was produced, SHOULD contain the parameters used for the expansion, and SHALL contain the codes that are obtained by evaluating the value set definition. If this is ONLY an executable value set, a distributable definition of the value set must be obtained to compute the updated expansion." ]
  ], [
     fhir:index 4 ;
     fhir:Element.extension [
       fhir:index 0 ;
       fhir:Extension.url [ fhir:value "type" ] ;
       fhir:Extension.valueCode [ fhir:value "documentation" ]
     ], [
       fhir:index 1 ;
       fhir:Extension.url [ fhir:value "text" ] ;
       fhir:Extension.valueMarkdown [ fhir:value "Maintenance search expression: `multiaxial_descendantsof:(LP18868-7 OR LP391552-9 OR LP426996-7) AND system:urine`. The compose anchors at three trunk LP codes - LP18868-7 (Amphetamines), LP391552-9 (Sympathomimetics), and LP426996-7 (Amphetamines panel) - using `concept is-a` filters scoped to SYSTEM=LP7681-2 (urine) and CLASSTYPE=1 (lab test). Codes from the LP248770-2 (Lab terms not yet categorized) bucket are emitted as an explicit concept list since filtering on that catch-all parent would over-pull uncategorized urine lab terms. To regenerate: re-run the search expression as a LOINC hierarchy query, add any newly-discovered trunk LP code as another is-a filter (or extend the concept list for catch-all leaves), then re-expand." ]
     ] ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/cqf-artifactComment" ]
  ] ;
