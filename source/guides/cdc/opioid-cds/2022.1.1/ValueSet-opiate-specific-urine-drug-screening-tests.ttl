  fhir:ValueSet.description [ fhir:value "Urine tests for naturally occurring opioids (i.e. opiates) that are specific to a particular naturally occurring opioid and therefore do not have the general word 'opiates' in the long name."] ;
  fhir:ValueSet.purpose [ fhir:value "Identification of urine drug tests where results can be used when considering pain management therapy"] ;
