  fhir:DomainResource.extension [
     fhir:index 0 ;
     fhir:Extension.url [ fhir:value "http://fhir.org/guides/cdc/opioid-cds/StructureDefinition/cdc-valueset-clinical-focus" ] ;
     fhir:Extension.valueString [ fhir:value "The purpose of this value set is to represent concepts for barbiturate medications" ]
  ], [
     fhir:index 1 ;
     fhir:Extension.url [ fhir:value "http://fhir.org/guides/cdc/opioid-cds/StructureDefinition/cdc-valueset-dataelement-scope" ] ;
     fhir:Extension.valueString [ fhir:value "Medication" ]
  ], [
     fhir:index 2 ;
     fhir:Extension.url [ fhir:value "http://fhir.org/guides/cdc/opioid-cds/StructureDefinition/cdc-valueset-inclusion-criteria" ] ;
     fhir:Extension.valueString [ fhir:value "Includes amobarbital, butabarbital, butalbital, pentobarbital, phenobarbital and secobarbital. Includes concepts that represent generic, human use and prescribable medications" ]
  ], [
     fhir:index 3 ;
     fhir:Extension.url [ fhir:value "http://fhir.org/guides/cdc/opioid-cds/StructureDefinition/cdc-valueset-exclusion-criteria" ] ;
     fhir:Extension.valueString [ fhir:value "Excludes concepts that represent non-prescribable or branded drugs and excludes concepts that represent components or ingredients" ]
  ], [
     fhir:index 4 ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-knowledgeCapability" ] ;
     fhir:Extension.valueCode [ fhir:value "computable" ]
  ], [
     fhir:index 5 ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-knowledgeCapability" ] ;
     fhir:Extension.valueCode [ fhir:value "executable" ]
  ], [
     fhir:index 6 ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/uv/cpg/StructureDefinition/cpg-usageWarning" ] ;
     fhir:Extension.valueString [ fhir:value "This value set contains a point-in-time expansion enumerating the codes that meet the value set intent. As new versions of the code systems used by the value set are released, the contents of this expansion will need to be updated to incorporate newly defined codes that meet the value set intent. Before, and periodically during production use, the value set expansion contents SHOULD be updated. The value set expansion specifies the timestamp when the expansion was produced, SHOULD contain the parameters used for the expansion, and SHALL contain the codes that are obtained by evaluating the value set definition. If this is ONLY an executable value set, a distributable definition of the value set must be obtained to compute the updated expansion." ]
  ], [
     fhir:index 7 ;
     fhir:Extension.url [ fhir:value "http://hl7.org/fhir/StructureDefinition/valueset-rules-text" ] ;
     fhir:Extension.valueMarkdown [ fhir:value "https://mor.nlm.nih.gov/RxMix/ Script:\r\nStep 1 \r\nCreate Batch text input file (SCT-60978003.txt) with following SCT identifier (for the concept \"Product containing barbiturate derivative (product)\") as an input within the file: \r\n60978003       \r\n\r\nStep 2\r\nSubmit batch job using the above SCT-60978003.txt file to following workflow by uploading the config file (Barbiturate-meds.config) with the following in the file:  <WFE><filteredOutputs>RXCUI|name|term_type</filteredOutputs><input>NOINPUT</input><FS><service>NOINPUT</service><function>getClassMembers</function><level>0</level><paramSize>5</paramSize><param order ='0'>?</param><param order ='1'>SNOMEDCT</param><param order ='2'>isa_structure</param><param order ='3'>0</param><param order ='4'>IN,MIN,PIN</param></FS><FS><service>NOINPUT</service><function>getRelatedByType</function><level>1</level><paramSize>2</paramSize><param order ='0'>?</param><param order ='1'>BPCK,GPCK,SBD,SCD</param></FS></WFE>\r\nThis will produce a result file with all Barbiturate clinical drugs included" ]
  ] ;
