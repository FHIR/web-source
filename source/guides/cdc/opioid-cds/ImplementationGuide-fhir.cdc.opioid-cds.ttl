       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir.org/guides/cdc/opioid-cds/Library/OMTKData> ;
         fhir:Reference.reference [ fhir:value "Library/OMTKData" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Opioid Management Terminology Knowledge Data" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "This library contains drug ingredient data for opioid ingredients of combinations drugs as determined using the [RxNav](https://rxnav.nlm.nih.gov/) API.\r\nThe content was produced using the process described [here](http://fhir.org/guides/cdc/opioid-cds/service-documentation.html#solution-component-1-medication-and-terminology-knowledge-base)." ]
     ], [
       fhir:index 52 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Library" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir.org/guides/cdc/opioid-cds/Library/OMTKLogic> ;
         fhir:Reference.reference [ fhir:value "Library/OMTKLogic" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Opioid Management Terminology Knowledge Logic" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "This library provides functionality for calculating Morphine Milligram Equivalents (MME) for opioid medications, as described in the CDC Opioid Prescribing Guideline." ]
     ], [
       fhir:index 53 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "PlanDefinition" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir.org/guides/cdc/opioid-cds/PlanDefinition/opioidcds-01> ;
         fhir:Reference.reference [ fhir:value "PlanDefinition/opioidcds-01" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Recommendation #1 - Nonpharmacologic and Nonopioid Pharmacologic Therapy Consideration" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Nonopioid therapies are at least as effective as opioids for many common types of acute pain. Clinicians should maximize use of nonpharmacologic and nonopioid pharmacologic therapies as appropriate for the specific condition and patient and only consider opioid therapy for acute pain if benefits are anticipated to outweigh risks to the patient. Before prescribing opioid therapy for acute pain, clinicians should discuss with patients the realistic benefits and known risks of opioid therapy." ]
     ], [
       fhir:index 54 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "PlanDefinition" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir.org/guides/cdc/opioid-cds/PlanDefinition/opioidcds-02> ;
         fhir:Reference.reference [ fhir:value "PlanDefinition/opioidcds-02" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Recommendation #2 - Opioid Therapy Goals Discussion" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Nonopioid therapies are preferred for subacute and chronic pain. Clinicians should maximize use of nonpharmacologic and nonopioid pharmacologic therapies as appropriate for the specific condition and patient and only consider initiating opioid therapy if expected benefits for pain and function are anticipated to outweigh risks to the patient. Before starting opioid therapy for subacute or chronic pain, clinicians should discuss with patients the realistic benefits and known risks of opioid therapy, should work with patients to establish treatment goals for pain and function, and should consider how opioid therapy will be discontinued if benefits do not outweigh risks." ]
     ], [
       fhir:index 55 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "PlanDefinition" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir.org/guides/cdc/opioid-cds/PlanDefinition/opioidcds-03> ;
         fhir:Reference.reference [ fhir:value "PlanDefinition/opioidcds-03" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Recommendation #3 - Opioid Immediate Release Form When Starting Opioid Therapy" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "When starting opioid therapy for acute, subacute, or chronic pain, clinicians should prescribe immediate-release opioids instead of extended-release and long-acting (ER/LA) opioids." ]
     ], [
       fhir:index 56 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "PlanDefinition" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir.org/guides/cdc/opioid-cds/PlanDefinition/opioidcds-04-05> ;
         fhir:Reference.reference [ fhir:value "PlanDefinition/opioidcds-04-05" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Recommendations #4 and #5 - Lowest Effective Dose" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Recommendation 4: When opioids are initiated for opioid-naïve patients with acute, subacute, or chronic pain, clinicians should prescribe the lowest effective dosage. If opioids are continued for subacute or chronic pain, clinicians should use caution when prescribing opioids at any dosage, should carefully evaluate individual benefits and risks when considering increasing dosage, and should avoid increasing dosage above levels likely to yield diminishing returns in benefits relative to risks to patients. Recommendation 5: For patients already receiving opioid therapy, clinicians should carefully weigh benefits and risks and exercise care when changing opioid dosage. If benefits outweigh risks of continued opioid therapy, clinicians should work closely with patients to optimize nonopioid therapies while continuing opioid therapy. If benefits do not outweigh risks of continued opioid therapy, clinicians should optimize other therapies and work closely with patients to gradually taper to lower dosages or, if warranted based on the individual circumstances of the patient, appropriately taper and discontinue opioids. Unless there are indications of a life-threatening issue such as warning signs of impending overdose (e.g., confusion, sedation, or slurred speech), opioid therapy should not be discontinued abruptly, and clinicians should not rapidly reduce opioid dosages from higher dosages." ]
     ], [
       fhir:index 57 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "PlanDefinition" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir.org/guides/cdc/opioid-cds/PlanDefinition/opioidcds-06> ;
         fhir:Reference.reference [ fhir:value "PlanDefinition/opioidcds-06" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Recommendation #6 - Prescribe Lowest Effective Dose and Duration" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "When opioids are needed for acute pain, clinicians should prescribe no greater quantity than needed for the expected duration of pain severe enough to require opioids." ]
     ], [
       fhir:index 58 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "PlanDefinition" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir.org/guides/cdc/opioid-cds/PlanDefinition/opioidcds-07> ;
         fhir:Reference.reference [ fhir:value "PlanDefinition/opioidcds-07" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Recommendation #7 - Opioid Therapy Risk Assessment" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Clinicians should evaluate benefits and risks with patients within 1-4 weeks of starting opioid therapy for subacute or chronic pain or of dosage escalation. Clinicians should regularly reevaluate benefits and risks of continued opioid therapy with patients." ]
     ], [
       fhir:index 59 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "PlanDefinition" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir.org/guides/cdc/opioid-cds/PlanDefinition/opioidcds-08> ;
         fhir:Reference.reference [ fhir:value "PlanDefinition/opioidcds-08" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Recommendation #8 - Naloxone Consideration" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Before starting and periodically during continuation of opioid therapy, clinicians should evaluate risk for opioid-related harms and discuss risk with patients. Clinicians should work with patients to incorporate into the management plan strategies to mitigate risk, including offering naloxone." ]
     ], [
       fhir:index 60 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "PlanDefinition" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir.org/guides/cdc/opioid-cds/PlanDefinition/opioidcds-09> ;
         fhir:Reference.reference [ fhir:value "PlanDefinition/opioidcds-09" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Recommendation #9 - Consider Patient's History of Controlled Substance Prescriptions" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "When prescribing initial opioid therapy for acute, subacute, or chronic pain, and periodically during opioid therapy for chronic pain, clinicians should review the patient's history of controlled substance prescriptions using state prescription drug monitoring program (PDMP) data to determine whether the patient is receiving opioid dosages or combinations that put the patient at high risk for overdose." ]
     ], [
       fhir:index 61 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "PlanDefinition" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://fhir.org/guides/cdc/opioid-cds/PlanDefinition/opioidcds-10-order-sign> ;
         fhir:Reference.reference [ fhir:value "PlanDefinition/opioidcds-10-order-sign" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Recommendation #10 - Urine Drug Testing (order-sign)" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "When prescribing opioids for subacute or chronic pain, clinicians should consider the benefits and risks of toxicology testing to assess for prescribed medications as well as other prescribed and nonprescribed controlled substances." ]
     ], [
       fhir:index 62 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
